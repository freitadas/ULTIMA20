{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ultima20",
  "main": "worker.js",
  "compatibility_date": "2026-10-30",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ultima-transmissao-db",
      "database_id": "COLE_AQUI_O_ID_REAL_DO_SEU_D1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {"name": "ROOMS", "class_name": "GameRoom"}
    ]
  },
  "migrations": [
    {"tag": "v4-room-001", "new_sqlite_classes": ["GameRoom"]}
  ]
}
